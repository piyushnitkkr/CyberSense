# ── LLM Provider (options: groq, anthropic, ollama, fake) ─────────────────────
# Groq (Free tier - recommended: https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here
LLM_PROVIDER=groq

# Anthropic (Optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: NVD API key (higher rate limits) ─────────────────────────────────
NVD_API_KEY=

# ── Optional: API key to protect the FastAPI endpoints ────────────────────────
API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Ollama (alternative LLM backend) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
