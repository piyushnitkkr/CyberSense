# ── LLM Provider (options: groq, anthropic, ollama, fake) ─────────────────────
# Groq (Free tier - recommended: https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here
LLM_PROVIDER=groq

# Anthropic (Optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: NVD API key (higher rate limits) ─────────────────────────────────
NVD_API_KEY=

# ── Optional: API key to protect the FastAPI endpoints ────────────────────────
API_KEY=

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
# Local (development):
QDRANT_URL=data/qdrant_db
# Production (Qdrant Cloud free tier - https://cloud.qdrant.io):
# QDRANT_URL=https://YOUR-CLUSTER-ID.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── SQLite Database ────────────────────────────────────────────────────────────
# Local:
DATABASE_URL=sqlite+aiosqlite:///data/cybersense.db
# Render.com (ephemeral disk):
# DATABASE_URL=sqlite+aiosqlite:////tmp/cybersense.db

# ── Ollama (alternative LLM backend) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
